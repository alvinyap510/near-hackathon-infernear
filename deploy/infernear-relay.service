[Unit]
Description=InferNear relay (API endpoint + keeper)
After=network-online.target
Wants=network-online.target

[Service]
User=infernear
WorkingDirectory=/opt/infernear/relay
ExecStart=/usr/bin/node --env-file=/opt/infernear/.env src/main.ts
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
