# Copy to .env and fill in. Never commit .env.
# Each component reads only its own section.

# --- relay: gateway ---
# Include the /v1 suffix for all upstream routes.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
API_KEY_SECRET=
RELAY_PORT=8787
# Public API origin: SIWE proofs bind to this host and URI origin.
RELAY_PUBLIC_URL=
# Dashboard origin allowed by browser CORS.
RELAY_WEB_ORIGIN=
RELAY_MAX_TOKENS=4096
# Total upstream deadline, including response-body streaming (not an idle timer).
RELAY_UPSTREAM_TIMEOUT_MS=120000
# Optional: header carrying the client IP from a proxy that is the only way in
# (cf-connecting-ip behind a Cloudflare Tunnel). Unset: rate limits use the socket IP.
RELAY_CLIENT_IP_HEADER=

# --- deploy (deploy/compose.yaml) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- relay: NEAR access ---
# Gateway/keeper use connector-scoped function-call keys.
NEAR_RPC_URL=
NEAR_CONNECTOR_ACCOUNT=
NEAR_GATEWAY_ACCOUNT=
NEAR_GATEWAY_PRIVATE_KEY=
NEAR_KEEPER_ACCOUNT=
NEAR_KEEPER_PRIVATE_KEY=
# Gas-only relay signer for Rhea run/request_withdraw and Intents execute_intents.
# Calls multiple receivers: use a funded full-access key on this relay account,
# never a vault key or the connector-scoped gateway/keeper function-call key.
NEAR_RELAY_ACCOUNT=
NEAR_RELAY_PRIVATE_KEY=
RHEA_VAULT_ACCOUNT=
NEAR_INTENTS_ACCOUNT=
# Alert threshold for free relay/vault balance after storage stake, in yoctoNEAR.
NEAR_LOW_BALANCE_YOCTO=100000000000000000000000

# --- contracts/near ---
# No compile-time env. Initialize with the NEAR_KEEPER_ACCOUNT and
# NEAR_GATEWAY_ACCOUNT above; NEAR_CONNECTOR_ACCOUNT identifies the contract.
# The connector account needs its own NEAR balance for code and ledger storage.

# Rhea vault: immutable constructor values and one-time deployment inputs.
NEAR_RHEA_VAULT_ACCOUNT=
NEAR_USDC_ACCOUNT=
NEAR_RHEA_ACCOUNT=
NEAR_INTENTS_ACCOUNT=
NEAR_RHEA_CUSHION=
NEAR_RHEA_MIN_DEPOSIT=1000000
NEAR_RHEA_CAP=1000000000
# Uses TREASURY_NEAR_ACCOUNT as the fixed yield recipient.
NEAR_RHEA_WASM=
NEAR_RHEA_INITIAL_NEAR=
NEAR_DEPLOYER_ACCOUNT=
NEAR_DEPLOYER_PRIVATE_KEY=
# Bootstrap only; the deployment script deletes all vault full-access keys last.
NEAR_RHEA_VAULT_PRIVATE_KEY=
# true keeps that bootstrap key (recoverable demo deployment; the vault then has an admin key).
NEAR_RHEA_KEEP_KEY=
# Set true only after the authorized tiny mainnet simple_withdraw probe proves exact delivery.
NEAR_RHEA_WITHDRAW_VERIFIED=

# --- relay: keeper (EVM side) ---
BASE_RPC_URL=
BASE_CHAIN_ID=8453
# JSON array; kind aave/rate/pendle. See relay/README.md for exact entry fields.
EVM_VAULTS=
# Earliest deployment block among the configured vaults, for Transfer discovery.
VAULT_START_BLOCK=
TREASURY_EVM_PRIVATE_KEY=
ONECLICK_API_URL=
ONECLICK_API_TOKEN=
# JSON array of {token, originAsset, minimumBaseUnits}; [] holds all EVM yield.
# Configure USDC today. Other yield tokens remain held until supported/configured.
ONECLICK_TOKENS=
ONECLICK_DESTINATION_ASSET=
ONECLICK_SLIPPAGE_BPS=100
TREASURY_NEAR_ACCOUNT=

# --- relay: opt-in live SDK spike (not needed by npm test or npm run demo) ---
SPIKE_SDK_DIR=
SPIKE_MODEL=
SPIKE_PROMPT=
SPIKE_MAX_TOKENS=32
SPIKE_USER_ID=

# --- contracts/evm ---
# Deploy.s.sol selects exactly one Base vault: aave, rate, or pendle.
EVM_VAULT_KIND=
# Aave constructor parameters (Base addresses are documented in contracts/evm/README.md).
EVM_USDC=
EVM_AAVE_POOL=
EVM_AUSDC=
# RateVault asset and constructor-fixed economic exchange-rate feed.
RATE_ASSET_ADDRESS=
RATE_FEED_ADDRESS=
# Pendle constructor addresses; the script reads c0 from the oracle's current spot rate.
PENDLE_MARKET_ADDRESS=
PENDLE_ORACLE_ADDRESS=
EVM_YIELD_RECIPIENT=
# Cushion: deposit-asset base units; cap: principal/share units. Operator chooses the cap.
EVM_CUSHION=
EVM_DEPOSIT_CAP=
# Used only by script/Deploy.s.sol; never commit a real key.
EVM_DEPLOYER_PRIVATE_KEY=
# Optional Base RPCs. Unset/empty skips that suite; Rate/Pendle pin block 53524164.
FORK_RPC_URL=
RATE_FORK_RPC_URL=
PENDLE_FORK_RPC_URL=

# --- web ---
VITE_RELAY_URL=http://localhost:8787
VITE_BASE_CHAIN_ID=8453
VITE_NEAR_RPC_URL=
VITE_NEAR_CONNECTOR_ACCOUNT=
VITE_BASE_RPC_URL=
# Aave vault (legacy screen default), plus the two other Base vaults.
VITE_VAULT_ADDRESS=
VITE_RATE_VAULT_ADDRESS=
VITE_PENDLE_VAULT_ADDRESS=
VITE_PENDLE_APP_URL=
# Rhea vault, NEAR USDC FT and configured Intents verifier.
VITE_RHEA_VAULT_ACCOUNT=
VITE_NEAR_USDC_ACCOUNT=
VITE_NEAR_INTENTS_ACCOUNT=
# Public 1Click endpoint, Base-USDC asset id and quote slippage in basis points.
# Previews are always dry. Only explicit confirmation methods request non-dry quotes.
VITE_ONECLICK_API_URL=
VITE_ONECLICK_BASE_USDC_ASSET=
VITE_ONECLICK_SLIPPAGE_BPS=100
