# Copy to .env and fill in. Never commit .env.
# Each component reads only its own section.

# --- relay: gateway ---
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
API_KEY_SECRET=
RELAY_PORT=8787
# Public API origin: SIWE proofs bind to this host and URI origin.
RELAY_PUBLIC_URL=
# Dashboard origin allowed by browser CORS.
RELAY_WEB_ORIGIN=
RELAY_MAX_TOKENS=4096

# --- relay: NEAR access (gateway and keeper use separate function-call keys) ---
NEAR_RPC_URL=
NEAR_CONNECTOR_ACCOUNT=
NEAR_GATEWAY_ACCOUNT=
NEAR_GATEWAY_PRIVATE_KEY=
NEAR_KEEPER_ACCOUNT=
NEAR_KEEPER_PRIVATE_KEY=

# --- contracts/near ---
# No compile-time env. Initialize with the NEAR_KEEPER_ACCOUNT and
# NEAR_GATEWAY_ACCOUNT above; NEAR_CONNECTOR_ACCOUNT identifies the contract.
# The connector account needs its own NEAR balance for code and ledger storage.

# --- relay: keeper (EVM side) ---
BASE_RPC_URL=
BASE_CHAIN_ID=8453
VAULT_ADDRESSES=
# Earliest deployment block among the configured vaults, for Transfer discovery.
VAULT_START_BLOCK=
# The keeper reuses EVM_USDC from the deployment section; v1 rejects other yield tokens.
TREASURY_EVM_PRIVATE_KEY=
ONECLICK_API_URL=
ONECLICK_API_TOKEN=
ONECLICK_ORIGIN_ASSET=
ONECLICK_DESTINATION_ASSET=
ONECLICK_SLIPPAGE_BPS=100
TREASURY_NEAR_ACCOUNT=

# --- relay: opt-in live SDK spike (not needed by npm test or npm run demo) ---
SPIKE_SDK_DIR=
SPIKE_MODEL=
SPIKE_PROMPT=
SPIKE_MAX_TOKENS=32
SPIKE_USER_ID=

# --- contracts/evm ---
# Constructor parameters; resolve Base addresses from the pinned Aave address book.
EVM_USDC=
EVM_AAVE_POOL=
EVM_AUSDC=
EVM_YIELD_RECIPIENT=
# Integer USDC base units (6 decimals). Alvin chooses the deposit cap.
EVM_CUSHION=
EVM_DEPOSIT_CAP=
# Used only by script/Deploy.s.sol; never commit a real key.
EVM_DEPLOYER_PRIVATE_KEY=
# Optional: fork tests run only when this is set to a Base mainnet RPC URL.
FORK_RPC_URL=
# Built/tested only: optional Ethereum forks. Leave RPC URLs unset to skip.
WSTETH_FORK_RPC_URL=
WSTETH_ADDRESS=
PENDLE_FORK_RPC_URL=
PENDLE_MARKET_ADDRESS=
PENDLE_ORACLE_ADDRESS=
STAKING_FORK_RPC_URL=
STAKING_POOL_ADDRESS=

# --- web ---
VITE_RELAY_URL=http://localhost:8787
VITE_BASE_CHAIN_ID=8453
VITE_NEAR_RPC_URL=
VITE_NEAR_CONNECTOR_ACCOUNT=
VITE_BASE_RPC_URL=
VITE_VAULT_ADDRESS=
